# ============================================================
# sag-benchmark Unified Environment Configuration
# ============================================================
# 使用方法: cp .env.example .env 然后按需修改
# 默认只读取项目根目录的 .env，不再向父目录搜索。
# 如需覆盖，请在启动 Python 前设置（不要只把该变量写入被选择的 dotenv）:
#   export SAG_ENV_FILE=/absolute/path/to/sag.env
#
# 项目说明:
#   - sag-benchmark: 主项目（pipeline 引擎 + evaluation）
#   - external/hipporag2: HippoRAG 2 (QA 方法 1)
#   - external/hypergraphrag: HyperGraphRAG (QA 方法 2)
#   - external/hyperrag: Hyper-RAG (QA 方法 3)
#   - external/judge: GraphRAG-Benchmark (LLM Judge 统一评测)
#
# 变量名映射（关键：各项目代码中变量名不完全一致，由本文件统一定义）:
#   hipporag2       → OPENAI_API_KEY  (同 LLM_API_KEY 值)
#   hyperrag        → EMB_BASE_URL    (同 EMBEDDING_BASE_URL 值)
#   hyperrag        → EMB_API_KEY     (同 EMBEDDING_API_KEY 值)
# ============================================================

# ============================================================
# LLM Configuration（通用 — 所有项目共用，不区分 QA/Judge）
# vLLM self-hosted, OpenAI 兼容
# ============================================================
LLM_API_KEY=xxx
LLM_MODEL=Qwen3.6-35B-A3B-FP8
LLM_BASE_URL=http://xxx:32768/v1
OPENAI_API_KEY=${LLM_API_KEY}

# ============================================================
# Embedding Configuration（通用 — 所有项目共用同一端点）
# bge-large-en-v1.5, dim=1024
# ============================================================
EMBEDDING_API_KEY=xxx
EMBEDDING_MODEL_NAME=text-embedding-bge-large-en-v1.5
EMBEDDING_BASE_URL=http://xxx:9990/v1
EMBEDDING_DIM=1024
# EMBEDDING_DIMENSIONS=1024       # public/upstream alias; EMBEDDING_DIM takes precedence
# EMBEDDING_REQUEST_DIMENSIONS=    # 透传给 embeddings.create(dimensions=…)（matryoshka 模型专用，留空则不传）
# EMBEDDING_DIM_STRICT=false       # true: probe 与 EMBEDDING_DIM 不符则报错；false: 以 probe 为准
# EMBEDDING_DIM_PROBE_TIMEOUT=30   # 维度 probe 超时（秒）
# ES_INDEX_LEGACY_UNSUFFIXED=true  # true: 1024 维沿用无后缀索引名；false: 统一 _<dim> 后缀
EMBED_MAX_TOKENS=512
EMB_BASE_URL=${EMBEDDING_BASE_URL}
EMB_API_KEY=${EMBEDDING_API_KEY}
# hipporag2: tokenizer 路径（留空=使用 embedding 服务器的 /tokenize API 精确截断）
EMBEDDING_TOKENIZER_PATH=

# ============================================================
# LLM 行为参数（可选，各项目有默认值；取消注释即可覆盖）
# ============================================================
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=12000
# LLM_TIMEOUT=180
# LLM_TOP_P=1.0
# LLM_FREQUENCY_PENALTY=0.0
# LLM_PRESENCE_PENALTY=0.0
# LLM_MAX_RETRIES=3
# LLM_ENABLE_THINKING=0

# ============================================================
# Database Configuration（仅 sag-benchmark 主项目使用）
# ============================================================
# Storage profiles:
#   mysql_es       -> MySQL + Elasticsearch (backward-compatible default)
#   oceanbase_es   -> OceanBase + Elasticsearch
#   oceanbase_full -> OceanBase database + OceanBase vector search
STORAGE_PROFILE=mysql_es
# Advanced overrides; leave blank to derive from STORAGE_PROFILE.
DATABASE_BACKEND=
VECTOR_BACKEND=

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=sag2
MYSQL_PASSWORD=sag2_pass
MYSQL_DATABASE=sag2

# OceanBase (used by oceanbase_es / oceanbase_full only)
OCEANBASE_HOST=localhost
OCEANBASE_PORT=2881
OCEANBASE_USER=sag2@sag2
OCEANBASE_PASSWORD=change_me
OCEANBASE_DATABASE=sag2
OCEANBASE_COMPAT_MODE=mysql
OCEANBASE_VECTOR_INDEX_TYPE=HNSW
OCEANBASE_VECTOR_INDEX_LIB=VSAG
OCEANBASE_VECTOR_INDEX_M=16
OCEANBASE_VECTOR_INDEX_EF_CONSTRUCTION=200
OCEANBASE_VECTOR_SEARCH_EF_SEARCH=64

DB_POOL_SIZE=100
DB_MAX_OVERFLOW=200
DB_POOL_RECYCLE=3600

# ============================================================
# Elasticsearch Configuration（仅 sag-benchmark 主项目使用）
# ============================================================
ES_HOST=localhost
ES_PORT=9201
ELASTIC_PASSWORD=your_password
ES_SCHEME=http
ES_USERNAME=elastic

# ============================================================
# Rerank Configuration
# ============================================================
RERANK_API_KEY=
RERANK_MODEL_NAME=Qwen/Qwen3-Reranker-8B
RERANK_BASE_URL=http://localhost:8000/v1
RERANK_ENDPOINT=/rerank

# ============================================================
# MLflow Configuration（仅 sag-benchmark 主项目使用）
# ============================================================
MLFLOW_PORT=5000
MLFLOW_URL=http://localhost:5000

# ============================================================
# Application Configuration（仅 sag-benchmark 主项目使用）
# ============================================================
SERVER_TYPE=LOCAL
LOG_LEVEL=INFO
DEBUG=false
BENCHMARK=false
LLM_LANGUAGE=en
LLM_DATA_INSPECTION=true

# ============================================================
# 各项目读取 .env 的方式
# ============================================================
# 所有 external 项目统一启动方式:
#   cd external/<project>
#   set -a && source ../../.env && set +a   # 导出所有变量到子进程
#   uv run python <entry_script>.py ...
#
# 变量名解读:
#   sag-benchmark: load_dotenv() 自动读取
#   hipporag2:     os.getenv('OPENAI_API_KEY') / os.getenv('EMBEDDING_BASE_URL')
#   hypergraphrag: os.getenv('LLM_API_KEY') / os.getenv('EMBEDDING_BASE_URL')
#   hyperrag:      os.getenv('LLM_API_KEY') / os.getenv('EMBEDDING_BASE_URL')
#   judge:         scripts/run_all_eval.sh 中用 grep 读 .env

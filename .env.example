# ============================================================================
# DataFlow Environment Configuration Sample
# ============================================================================
# Copy this file to .env and fill in your actual values

# ============================================================================
# Storage Backend Selection
# ============================================================================
# User-facing profiles:
#   mysql_es        -> DATABASE_BACKEND=mysql,      VECTOR_BACKEND=elasticsearch
#   oceanbase_es    -> DATABASE_BACKEND=oceanbase, VECTOR_BACKEND=elasticsearch
#   oceanbase_full  -> DATABASE_BACKEND=oceanbase, VECTOR_BACKEND=oceanbase
STORAGE_PROFILE=oceanbase_full

# Advanced override. Leave blank to derive from STORAGE_PROFILE.
DATABASE_BACKEND=
VECTOR_BACKEND=

# ============================================================================
# MySQL Database Configuration
# ============================================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=sag2
MYSQL_PASSWORD=sag2_pass
MYSQL_DATABASE=sag2

# ============================================================================
# OceanBase Database Configuration (MySQL-compatible tenant)
# ============================================================================
OCEANBASE_HOST=localhost
OCEANBASE_PORT=2881
OCEANBASE_USER=sag2@sag2
OCEANBASE_PASSWORD=sag2_pass
OCEANBASE_DATABASE=sag2
OCEANBASE_COMPAT_MODE=mysql

# OceanBase vector index build options. Distance is fixed to COSINE to match Elasticsearch.
# OceanBase 4.3.5 syntax:
# CREATE VECTOR INDEX idx ON table_name(vector_col)
# WITH (distance=cosine, type=hnsw, lib=vsag, m=16, ef_construction=200)
OCEANBASE_VECTOR_INDEX_TYPE=HNSW
OCEANBASE_VECTOR_INDEX_LIB=VSAG
OCEANBASE_VECTOR_INDEX_M=16
OCEANBASE_VECTOR_INDEX_EF_CONSTRUCTION=200

# OceanBase vector query options. The provider should append this at search time:
# ORDER BY VECTOR_DISTANCE(...) APPROX LIMIT :top_k PARAMETERS (ef_search=64)
OCEANBASE_VECTOR_SEARCH_EF_SEARCH=64

# Database connection pool settings
DB_POOL_SIZE=100
DB_MAX_OVERFLOW=200
DB_POOL_RECYCLE=3600

# ============================================================================
# Elasticsearch Configuration
# ============================================================================
ES_HOST=localhost
ES_PORT=9200
ES_USERNAME=elastic
ELASTIC_PASSWORD=your_password
ES_SCHEME=http

# ============================================================================
# LLM Configuration (Primary Language Model)
# ============================================================================
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.302ai.com/v1
LLM_MODEL=qwen3.6-flash

# Model Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=30000
LLM_TOP_P=1.0
LLM_FREQUENCY_PENALTY=0.0
LLM_PRESENCE_PENALTY=0.0

# Reliability Settings
LLM_TIMEOUT=300
LLM_MAX_RETRIES=5

# Language Setting (zh / en)
LLM_LANGUAGE=en

# ============================================================================
# Embedding Model Configuration
# ============================================================================
EMBEDDING_API_KEY=1
EMBEDDING_BASE_URL=http://192.168.110.12:9990/v1
EMBEDDING_MODEL_NAME=text-embedding-bge-large-en-v1.5
EMBEDDING_DIMENSIONS=1024

# ============================================================================
# Rerank Model Configuration
# ============================================================================
# Leave blank to reuse EMBEDDING_API_KEY / LLM_API_KEY
RERANK_API_KEY=
# Leave blank to use the default in code: Qwen/Qwen3-Reranker-8B
RERANK_MODEL_NAME=Qwen/Qwen3-Reranker-8B
# Base URL without the rerank path is OK; the client appends RERANK_ENDPOINT below
RERANK_BASE_URL=http://localhost:8000/v1
# Rerank request path appended to RERANK_BASE_URL. Default: /rerank
# Use /reranks for platforms that route via /v1/reranks (e.g. Cohere-compatible).
# If RERANK_BASE_URL already ends with the rerank path, it is used as-is.
RERANK_ENDPOINT=/rerank

# ============================================================================
# MLflow Configuration
# ============================================================================
# MLflow Docker container port mapping (used by the mlflow service in docker-compose.yml)
MLFLOW_PORT=5000

# MLflow Tracking Server URL (used by run_search_benchmark.py --mlflow-url)
# Format: http://<host>:<port>
# Examples:
#   - Local: http://localhost:5000
#   - Remote: http://192.168.1.100:5000
MLFLOW_URL=http://localhost:5000

# ============================================================================
# Application Settings
# ============================================================================
SERVER_TYPE=LOCAL
LOG_LEVEL=INFO
DEBUG=false
BENCHMARK=false
